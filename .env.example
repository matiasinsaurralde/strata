# Copy to .env and fill in. .env is gitignored — never commit real secrets.
# Real environment variables override anything set here.

# --- Model endpoint -------------------------------------------------------
# Any OpenAI-compatible endpoint. For Azure OpenAI use the /openai/v1 form:
#   https://<resource>.openai.azure.com/openai/v1
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# NOTE: OPENAI_BASE_URL and OPENAI_API_KEY resolve together as a pair. Setting
# only one in your shell while the other comes from this file is rejected
# rather than silently pairing a key with the wrong endpoint — see
# strata/env.py. Override both, or neither.

# --- Optional -------------------------------------------------------------
# Where prompts/, schemas/ and data/ live, if not alongside pyproject.toml.
# STRATA_ROOT=

# Credential handed to the Codex runtime by the sandboxed adjudicator. Derived
# from OPENAI_API_KEY; set it only to point the sandbox at a different provider.
# STRATA_PROVIDER_KEY=
