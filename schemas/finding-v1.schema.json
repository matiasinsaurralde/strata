{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://strata.local/schemas/finding-v1.schema.json",
  "title": "FindingV1",
  "description": "An evidence-backed adjudicator result. Finding details exist only for YES.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "commit_sha",
    "parent_sha",
    "verdict",
    "provenance",
    "root_cause",
    "attacker_preconditions",
    "impact",
    "fix_effect",
    "l0_class",
    "cwe_id",
    "severity",
    "affected_paths",
    "evidence",
    "fix_completeness",
    "invariant",
    "decision_reason",
    "reachability_delta",
    "failure_containment"
  ],
  "properties": {
    "schema_version": {
      "const": "finding-v1"
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "commit_sha": {
      "$ref": "#/$defs/git_sha"
    },
    "parent_sha": {
      "oneOf": [
        {
          "$ref": "#/$defs/git_sha"
        },
        {
          "type": "null"
        }
      ]
    },
    "verdict": {
      "enum": [
        "YES",
        "NO",
        "ABSTAIN"
      ]
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "root_cause": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "attacker_preconditions": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "impact": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "fix_effect": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "l0_class": {
      "oneOf": [
        {
          "$ref": "#/$defs/l0_class"
        },
        {
          "type": "null"
        }
      ]
    },
    "cwe_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^CWE-[1-9][0-9]{0,5}$"
        },
        {
          "type": "null"
        }
      ],
      "$comment": "Canonical CWE identifier syntax; catalog version CWE-4.20 is pinned in data/cwe-catalog-4.20.json."
    },
    "severity": {
      "oneOf": [
        {
          "$ref": "#/$defs/severity"
        },
        {
          "type": "null"
        }
      ]
    },
    "affected_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/relative_path"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "fix_completeness": {
      "oneOf": [
        {
          "enum": [
            "complete",
            "multi",
            "partial",
            "unknown"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "invariant": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "decision_reason": {
      "type": "string",
      "minLength": 1
    },
    "reachability_delta": {
      "description": "Whether the patch shrinks the attacker-reachable set. Only 'narrows' can be a fix.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "verdict",
            "before",
            "after"
          ],
          "properties": {
            "verdict": {
              "enum": [
                "narrows",
                "widens",
                "unchanged"
              ]
            },
            "before": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400
            },
            "after": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "failure_containment": {
      "description": "Whether a repaired fault is absorbed by the runtime or framework. 'contained' cannot be a fix.",
      "oneOf": [
        {
          "enum": [
            "unrecoverable",
            "contained",
            "n/a"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "YES"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "properties": {
          "root_cause": {
            "type": "string",
            "minLength": 1
          },
          "attacker_preconditions": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "fix_effect": {
            "type": "string",
            "minLength": 1
          },
          "l0_class": {
            "$ref": "#/$defs/l0_class"
          },
          "severity": {
            "$ref": "#/$defs/severity"
          },
          "affected_paths": {
            "minItems": 1
          },
          "evidence": {
            "minItems": 1,
            "allOf": [
              {
                "$ref": "#/$defs/supports_root_cause"
              },
              {
                "$ref": "#/$defs/supports_attacker_preconditions"
              },
              {
                "$ref": "#/$defs/supports_impact"
              },
              {
                "$ref": "#/$defs/supports_fix_effect"
              },
              {
                "$ref": "#/$defs/supports_l0_class"
              },
              {
                "$ref": "#/$defs/supports_severity"
              },
              {
                "$ref": "#/$defs/supports_affected_paths"
              },
              {
                "$ref": "#/$defs/supports_fix_completeness"
              }
            ]
          },
          "fix_completeness": {
            "enum": [
              "complete",
              "multi",
              "partial",
              "unknown"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "enum": [
              "NO",
              "ABSTAIN"
            ]
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "properties": {
          "root_cause": {
            "type": "null"
          },
          "attacker_preconditions": {
            "type": "null"
          },
          "impact": {
            "type": "null"
          },
          "fix_effect": {
            "type": "null"
          },
          "l0_class": {
            "type": "null"
          },
          "cwe_id": {
            "type": "null"
          },
          "severity": {
            "type": "null"
          },
          "affected_paths": {
            "maxItems": 0
          },
          "evidence": {
            "maxItems": 0
          },
          "fix_completeness": {
            "type": "null"
          },
          "invariant": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "YES"
          },
          "cwe_id": {
            "type": "string"
          }
        },
        "required": [
          "verdict",
          "cwe_id"
        ]
      },
      "then": {
        "properties": {
          "evidence": {
            "$ref": "#/$defs/supports_cwe_id"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "YES"
          },
          "invariant": {
            "type": "string"
          }
        },
        "required": [
          "verdict",
          "invariant"
        ]
      },
      "then": {
        "properties": {
          "evidence": {
            "$ref": "#/$defs/supports_invariant"
          }
        }
      }
    }
  ],
  "$defs": {
    "git_sha": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000\\\\]+$"
    },
    "l0_class": {
      "enum": [
        "memory_safety",
        "input_validation",
        "injection",
        "path_traversal",
        "access_control",
        "authentication",
        "cryptography",
        "resource_exhaustion",
        "concurrency_toctou",
        "deserialization",
        "information_disclosure",
        "logic_flaw",
        "supply_chain",
        "other"
      ]
    },
    "severity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "source",
        "score",
        "vector"
      ],
      "properties": {
        "level": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical",
            "unknown"
          ]
        },
        "source": {
          "enum": [
            "cvss",
            "advisory",
            "repository",
            "human",
            "model_estimate"
          ]
        },
        "score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 10
        },
        "vector": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "if": {
        "not": {
          "properties": {
            "source": {
              "const": "cvss"
            }
          },
          "required": [
            "source"
          ]
        }
      },
      "then": {
        "properties": {
          "vector": {
            "type": "null"
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "revision_sha",
        "path",
        "start_line",
        "end_line",
        "quoted_span",
        "supports"
      ],
      "properties": {
        "revision": {
          "enum": [
            "parent",
            "commit",
            "head"
          ]
        },
        "revision_sha": {
          "$ref": "#/$defs/git_sha"
        },
        "path": {
          "$ref": "#/$defs/relative_path"
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1,
          "$comment": "FindingV1 additionally enforces end_line >= start_line."
        },
        "quoted_span": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "supports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "failure_containment",
              "reachability_delta",
              "root_cause",
              "attacker_preconditions",
              "impact",
              "fix_effect",
              "l0_class",
              "cwe_id",
              "severity",
              "affected_paths",
              "fix_completeness",
              "invariant"
            ]
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt_id",
        "prompt_hash",
        "schema_hash",
        "created_at",
        "tool_policy_hash",
        "backend_request_ids",
        "retry_count",
        "cache_hit"
      ],
      "properties": {
        "prompt_id": {
          "type": "string",
          "minLength": 1
        },
        "prompt_hash": {
          "$ref": "#/$defs/hash"
        },
        "schema_hash": {
          "$ref": "#/$defs/hash"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "tool_policy_hash": {
          "oneOf": [
            {
              "$ref": "#/$defs/hash"
            },
            {
              "type": "null"
            }
          ]
        },
        "backend_request_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "retry_count": {
          "type": "integer",
          "minimum": 0
        },
        "cache_hit": {
          "type": "boolean"
        }
      }
    },
    "supports_root_cause": {
      "contains": {
        "properties": {
          "supports": {
            "contains": {
              "const": "root_cause"
            }
          }
        }
      }
    },
    "supports_attacker_preconditions": {
      "contains": {
        "properties": {
          "supports": {
            "contains": {
              "const": "attacker_preconditions"
            }
          }
        }
      }
    },
    "supports_impact": {
      "contains": {
        "properties": {
          "supports": {
            "contains": {
              "const": "impact"
            }
          }
        }
      }
    },
    "supports_fix_effect": {
      "contains": {
        "properties": {
          "supports": {
            "contains": {
              "const": "fix_effect"
            }
          }
        }
      }
    },
    "supports_l0_class": {
      "contains": {
        "properties": {
          "supports": {
            "contains": {
              "const": "l0_class"
            }
          }
        }
      }
    },
    "supports_cwe_id": {
      "contains": {
        "properties": {
          "supports": {
            "contains": {
              "const": "cwe_id"
            }
          }
        }
      }
    },
    "supports_severity": {
      "contains": {
        "properties": {
          "supports": {
            "contains": {
              "const": "severity"
            }
          }
        }
      }
    },
    "supports_affected_paths": {
      "contains": {
        "properties": {
          "supports": {
            "contains": {
              "const": "affected_paths"
            }
          }
        }
      }
    },
    "supports_fix_completeness": {
      "contains": {
        "properties": {
          "supports": {
            "contains": {
              "const": "fix_completeness"
            }
          }
        }
      }
    },
    "supports_invariant": {
      "contains": {
        "properties": {
          "supports": {
            "contains": {
              "const": "invariant"
            }
          }
        }
      }
    }
  }
}
